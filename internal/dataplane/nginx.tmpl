# Managed by HostNginxGateway. Do not edit by hand -- next sync will overwrite.
{{- if .ErrorLog }}
error_log {{ .ErrorLog }};
{{- end }}

# WebSocket proxying: HTTP/1.1 with hop-by-hop Upgrade/Connection handling.
# One map for the whole http context; every proxying location forwards the
# Upgrade/Connection headers through it.
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
{{- range .Maps }}

map {{ .Source }} ${{ .Name }} {
{{- range .Entries }}
    {{ mapKey .Key }} {{ mapValue .Value }};
{{- end }}
}
{{- end }}
{{- range .SplitClients }}

split_clients {{ .Source }} ${{ .Name }} {
{{- range .Entries }}
    {{ splitKey .Percent }} {{ mapValue .Value }};
{{- end }}
}
{{- end }}

{{- range .Upstreams }}

upstream {{ .Name }} {
    zone {{ .Name }} 64k;
{{- range .Endpoints }}
{{- if .Socket }}
    server unix:{{ $.ProxySocketsDir }}/{{ .Socket }}{{ if .Weight }} weight={{ .Weight }}{{ end }}{{ if not .Ready }} down{{ end }};
{{- else }}
    server {{ .IP }}:{{ .Port }}{{ if .Weight }} weight={{ .Weight }}{{ end }}{{ if not .Ready }} down{{ end }};
{{- end }}
{{- end }}
}
{{- end }}

{{- range .Servers }}

server {
{{- range .Listens }}
    {{ buildListen . }}
{{- end }}
    server_name {{ buildServerName .Hostname }};
{{- if .TLSCert }}
    {{ buildTLS .TLSCert }}
{{- end }}
{{- if .RawServerSnippet }}
{{ .RawServerSnippet }}
{{- end }}
{{- range .Locations }}
    location {{ .Path }} {
{{ buildLocation . }}
{{- if .RawSnippet }}
{{ .RawSnippet }}
{{- end }}
    }
{{- end }}
}
{{- end }}